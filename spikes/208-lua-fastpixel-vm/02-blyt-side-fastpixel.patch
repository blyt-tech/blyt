+/* Fast-path builtin identities for the OP_CALL-inline VM patch (#208 2b): the
+ * Lua VM (lvm.c, built with BLYT_LUA_FASTPIXEL for the guest) compares the
+ * OP_CALL callee against these and, for the common case (a live lock, integer
+ * args, in bounds), runs the get/set inline on the materialized buffer — eliding
+ * the Lua C-call frame. Anything unusual (OOB / stale / released / non-integer
+ * args) falls through to the C functions above, which remain the source of truth
+ * for the checked semantics.  Non-static so lvm.c resolves them within the .so. */
+int (*blyt_lua_fp_get)(lua_State *) = lua_lock_get;
+int (*blyt_lua_fp_set)(lua_State *) = lua_lock_set;
+/* Lock metatable identity, captured at registration.  The VM fast path checks
+ * the self userdata's metatable against this before treating it as a lock — so a
+ * cart that calls the get/set builtin with a foreign self falls through to the C
+ * function (which errors via luaL_checkudata) rather than reading raw memory. */
+void *blyt_lua_lock_mt = NULL;
+
 /* Build the lock metatable: __index method table with get/set/release + the
  * in-lock bulk primitives. */
 static void register_surface_lock_mt(lua_State *L) {
