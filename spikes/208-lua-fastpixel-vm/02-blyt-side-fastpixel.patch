+# #208 2b (spike): the tier-2 lock get/set VM fast path in libblyt32lua's lvm.c.
+# ON by default; build a baseline (2a, no fast path) lib with -DBLYT_LUA_FASTPIXEL=OFF
+# for the spike comparison.  Pure speed optimization — output is identical either way.
+option(BLYT_LUA_FASTPIXEL "Enable the tier-2 Lua per-pixel VM fast path (#208 2b)" ON)
+if(BLYT_LUA_FASTPIXEL)
+  set(_BLYT_LUA_FASTPIXEL_FLAG "-DBLYT_LUA_FASTPIXEL=1")
+else()
+  set(_BLYT_LUA_FASTPIXEL_FLAG "")
+endif()
+
 # ── Base flags ───────────────────────────────────────────────────────────────
 set(RV32_BASE
     # riscv32-linux-gnu (not bare-metal riscv32): lld injects -static for
@@ -752,6 +762,14 @@ else()
       ${_VOPT}
       -DBLYT_LUA_I32_F64=1
       -DLUA_USE_LONGJMP=1
+      # #208 2b (spike): OP_CALL-inline + index-opcode fast path for the tier-2
+      # lock get/set in lvm.c.  Only the thick libblyt32lua embeds both the VM and
+      # blyt32lua.c (which defines the fast-path identities the patch resolves), so
+      # the flag lives here.  A pure speed optimization — output is identical to
+      # the slow path, so the host-Lua WASM leg (no flag) stays coherent.  Gated by
+      # the BLYT_LUA_FASTPIXEL option (ON) so a baseline (2a) lib can be built with
+      # -DBLYT_LUA_FASTPIXEL=OFF for the spike comparison.
+      ${_BLYT_LUA_FASTPIXEL_FLAG}
       ${LUA_SEED_DEF}
       ${_VLUA_DAP_FLAGS}
       -I
