build/
build-*/
target/
# third_party/ is gitignored: deps are fetched via CMake FetchContent at
# configure time into ~/.cache/blyt/fetchcontent/ (shared across worktrees).
# Clone a fork into third_party/<dep> for local patch work; cmake
# auto-detects a populated checkout and uses it instead of downloading.
third_party/
devtool/target/
tests/wasm/node_modules/
tools/vscode/node_modules/
examples/*/.vscode/
# Cart Cargo.lock is regenerated per build; the SDK crate is injected via a
# build-time --config patch, so a committed lock just drifts.
examples/**/Cargo.lock
.cache/
qemu-images/*
!qemu-images/.gitkeep
.DS_Store
