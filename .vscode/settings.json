{
    // CMake Tools: build into build/, Debug for source-level stepping.
    // FLATCC_DEBUG_CLANG_SANITIZE=OFF (set in CMakeLists.txt) prevents flatcc
    // from adding -fsanitize=undefined in debug builds, so this is safe.
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.buildType": "Debug",
    "cmake.configureArgs": ["-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],

    // C/C++ extension: use compile_commands.json generated by CMake for accurate
    // IntelliSense on host-side code. Fallback paths are in c_cpp_properties.json.
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",

    // rust-analyzer: single workspace root covering devtool/ and tests/integration/
    "rust-analyzer.linkedProjects": ["${workspaceFolder}/Cargo.toml"],

    // clang-format is applied on save for C files
    "editor.formatOnSave": true,
    "[c]": {
        "editor.formatOnSave": true
    },
    "[rust]": {
        "editor.formatOnSave": true
    },

    // Treat .h files as C (not C++) since this project is pure C
    "files.associations": {
        "*.h": "c"
    }
}
