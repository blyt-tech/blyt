{
    "configurations": [
        {
            // Host runtime: libblyt, SDL2 frontend, unit tests.
            // compile_commands.json (generated by cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
            // provides exact flags; the includePath/defines below are the fallback for
            // when cmake hasn't been run yet.
            "name": "Host (macOS)",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/runtime/host/include",
                "${workspaceFolder}/runtime/host/src/libblyt",
                "${workspaceFolder}/third_party/flatcc/include",
                "${workspaceFolder}/build/generated/flatbuffers",
                "${workspaceFolder}/third_party/rv32emu/src"
            ],
            "defines": [
                "RV32_FEATURE_SDL=0",
                "RV32_FEATURE_GDBSTUB=0",
                "RV32_FEATURE_JIT=0",
                "RV32_FEATURE_T2C=0",
                "RV32_FEATURE_SYSTEM=0",
                "RV32_FEATURE_ELF_LOADER=0",
                "RV32_FEATURE_ARCH_TEST=0"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c11",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            // Guest libraries: libblytcommon, libblyt32 — cross-compiled for RV32IMAFC.
            // The SDK toolchain clang is used so IntelliSense understands the 32-bit ABI.
            // Run `cmake --build build --target sdk` once to populate build/sdk/toolchain/.
            "name": "Guest (RV32IMAFC)",
            "includePath": [
                "${workspaceFolder}/runtime/guest/include"
            ],
            "defines": [],
            "compilerPath": "${workspaceFolder}/build/sdk/toolchain/bin/clang",
            "compilerArgs": [
                "--target=riscv32",
                "-march=rv32imafc",
                "-mabi=ilp32f"
            ],
            "cStandard": "c11",
            "intelliSenseMode": "linux-clang-x86"
        }
    ],
    "version": 4
}
