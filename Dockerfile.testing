# Dockerfile.testing — Linux test environment matching GitHub Actions ubuntu-24.04.
#
# Used by the test-linux-docker cmake target to run integration tests locally on
# a Linux guest that mirrors CI.  Build time: ~15 min first run; cached layers
# rebuild in seconds.
#
# Usage (via cmake):
#   cmake --build build --target test-linux-docker
#   # single test:
#   cmake -DBLYT_LINUX_TEST_FILTER=sdl_hybrid_gdb_and_dap -B build
#   cmake --build build --target test-linux-docker

FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ── System packages + LLVM 22 ──────────────────────────────────────────────────
# libc6-dev-riscv64-cross ships gnu/stubs-ilp32f.h (old ABI) but not
# gnu/stubs-ilp32d.h (ilp32d ABI). The bridge build uses
# --target=riscv32-linux-gnu -mabi=ilp32d -nostdlib; clang still resolves
# gnu/stubs.h through the riscv64-linux-gnu sysroot. Empty stub is enough
# since libc is never linked anyway.
RUN apt-get update -q \
    && apt-get install -y --no-install-recommends curl ca-certificates gpg \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/apt.llvm.org.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/apt.llvm.org.gpg] \
       https://apt.llvm.org/noble/ llvm-toolchain-noble-22 main" \
       > /etc/apt/sources.list.d/llvm-22.list \
    && apt-get update -q \
    && apt-get install -y --no-install-recommends \
       cmake ninja-build libsdl2-dev \
       clang-22 lld-22 llvm-22 lldb-22 \
       qemu-system-misc \
       gcc-riscv64-linux-gnu binutils-riscv64-linux-gnu \
       libc6-dev-riscv64-cross libgcc-s1-riscv64-cross \
       python3-pip git pkg-config binutils xz-utils \
    && mkdir -p /usr/riscv64-linux-gnu/include/gnu \
    && touch /usr/riscv64-linux-gnu/include/gnu/stubs-ilp32d.h \
    && update-alternatives \
       --install /usr/bin/clang        clang        /usr/bin/clang-22        100 \
    && update-alternatives \
       --install /usr/bin/clang++       clang++       /usr/bin/clang++-22       100 \
    && update-alternatives \
       --install /usr/bin/cc            cc            /usr/bin/clang-22        100 \
    && update-alternatives \
       --install /usr/bin/c++           c++           /usr/bin/clang++-22      100 \
    && update-alternatives \
       --install /usr/bin/ld.lld        ld.lld        /usr/bin/ld.lld-22        100 \
    && update-alternatives \
       --install /usr/bin/llvm-objcopy  llvm-objcopy  /usr/bin/llvm-objcopy-22  100 \
    && update-alternatives \
       --install /usr/bin/llvm-ar       llvm-ar       /usr/bin/llvm-ar-22       100 \
    && update-alternatives \
       --install /usr/bin/lldb-dap      lldb-dap      /usr/bin/lldb-dap-22      100 \
    && pip3 install --break-system-packages clang-format==22.1.5 cmakelang yamllint \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Node.js 22 ─────────────────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Rust ───────────────────────────────────────────────────────────────────────
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --default-toolchain stable \
    # Cart Rust builds use -Z build-std (nightly + rust-src) to recompile
    # core/alloc as PIC for the PIE cart ELF (ADR-0108). Keep this dated nightly
    # in sync with CART_RUST_TOOLCHAIN in devtool/src/build.rs (and ci.yml).
    && rustup toolchain install nightly-2026-06-01 --profile minimal --component rust-src

# ── Emscripten SDK ─────────────────────────────────────────────────────────────
# Pinned, and must stay in sync with the setup-emsdk `version:` in ci.yml — this
# image exists to mirror CI, and a floating `latest` silently compiles the WASM
# legs with a different emcc than CI does. That is not hypothetical: `latest`
# reached 6.0.2 while CI was pinned to 6.0.0, and 6.0.x dropped `wasmBinary`
# from the default INCOMING_MODULE_JS_API allowlist, so the single-file HTML
# export (devtool/src/export.rs) aborted on load and
# wasm_canvas_renders_in_browser failed here but not in CI (#285). Bump this and
# ci.yml together, as a deliberate change (an upgrade also invalidates the WASM
# compiler cache).
RUN git clone --depth 1 https://github.com/emscripten-core/emsdk.git /opt/emsdk \
    && /opt/emsdk/emsdk install 6.0.0 \
    && /opt/emsdk/emsdk activate 6.0.0
ENV EMSDK=/opt/emsdk \
    EM_CONFIG=/opt/emsdk/.emscripten

# ── Playwright headless chromium (WASM browser-render test) ─────────────────────
# The wasm_canvas_renders_in_browser test launches headless chromium via
# Playwright.  node_modules is gitignored, so at runtime the test resolves the
# Playwright JS from the mounted repo's node_modules; only the browser binary
# must be present in the image cache (/root/.cache/ms-playwright).  Install it
# from tests/wasm's lockfile so the chromium revision matches the pinned
# playwright (mirrors ci.yml's "Install Playwright" step).
COPY tests/wasm/package.json tests/wasm/package-lock.json /opt/playwright/
RUN cd /opt/playwright \
    && npm ci \
    && npx playwright install --with-deps chromium \
    && rm -rf /opt/playwright/node_modules

# ── Compiler caches ─────────────────────────────────────────────────────────────
# ccache is picked up automatically at CMake configure time
# (cmake/blyt_ccache.cmake); sccache by the blyt devtool for cart rustc
# invocations (-Z build-std).  Both store into the blyt-compiler-cache-<arch>
# volume (see the test-linux-docker target), so C/C++ compiles replay across
# build-volume wipes and the per-run fixture-cart build-std compiles replay on
# every test run.  Kept as the last layer so adding it does not invalidate the
# expensive toolchain layers above.
RUN apt-get update -q \
    && apt-get install -y --no-install-recommends ccache \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/mozilla/sccache/releases/download/v0.15.0/sccache-v0.15.0-$(uname -m)-unknown-linux-musl.tar.gz" \
       | tar -xz -C /usr/local/bin --strip-components=1 --wildcards '*/sccache' \
    && chmod +x /usr/local/bin/sccache

# ── VS Code debugger integration suite deps ─────────────────────────────────────
# The test-vscode leg runs a headless VS Code (Electron) via
# @vscode/test-electron and opens an SDL2 window per native debug session, so it
# needs a virtual framebuffer (xvfb) plus Electron's GUI runtime libs. Most of
# the latter are already pulled in by Playwright's `--with-deps chromium` above;
# the explicit set here covers the few Electron-specific extras and pins the
# names on 24.04 (the t64 ABI-transition renames). The pinned VS Code build
# itself is NOT baked in — it is downloaded on first run into the
# blyt-vscode-test-cache-<arch> volume (see the test-linux-docker target), so
# repeat runs do not re-download it. Kept as a late layer so it does not
# invalidate the expensive toolchain/emsdk/playwright layers above.
RUN apt-get update -q \
    && apt-get install -y --no-install-recommends \
       xvfb dbus-x11 \
       libnss3 libnspr4 libgbm1 libasound2t64 libgtk-3-0t64 \
       libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libatspi2.0-0t64 \
       libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
       libxrandr2 libxshmfence1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
