// Typed layout declarations embedded in the .cart.layouts ELF section.
// Read by the runtime loader; written by blyt build codegen.
//
// type_tag values for FieldDecl:
//   0=i8  1=u8  2=i16  3=u16  4=i32  5=u32  6=f32  7=bool  8=f64

namespace blyt;

table FieldDecl {
    name:     string;
    type_tag: uint8;
}

table RecordDecl {
    name:   string;
    fields: [FieldDecl];
}

table BufferDecl {
    name:        string;
    record_name: string;
    count:       uint32;
}

table CartLayouts {
    records:     [RecordDecl];
    buffers:     [BufferDecl];
    schema_hash: uint64;
}

root_type CartLayouts;
