{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"files": {
		"includes": [
			"**/*.js",
			"**/*.mjs",
			"**/*.cjs",
			"!**/build",
			"!**/build-*",
			"!**/third_party",
			"!**/examples/*/build",
			"!**/build-riscv64",
			"!**/emsdk-cache",
			"!**/.vscode-test"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noAssignInExpressions": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 4,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"overrides": [
		{
			"includes": ["**/frontends/wasm/module_pre.js"],
			"javascript": {
				"globals": ["FS", "ENV"]
			}
		}
	]
}
