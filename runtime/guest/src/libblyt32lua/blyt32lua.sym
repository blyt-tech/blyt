{
  global:
    /* Lua API subset used by BLYT_LUA_EXPORT_* macro-generated wrappers */
    lua_tointegerx;
    lua_tonumberx;
    lua_toboolean;
    lua_pushinteger;
    lua_pushnumber;
    lua_pushboolean;
    /* Lua API used by SDK-generated cart_lua_modules glue
     * (lua_pushcfunction/lua_newtable/lua_istable/lua_pop are macros over these) */
    lua_pushcclosure;
    lua_createtable;
    lua_type;
    lua_settop;
    lua_setglobal;
    lua_setfield;
    lua_pushvalue;
    lua_getglobal;
    lua_getfield;
    /* Error reporting and arg checking */
    luaL_error;
    luaL_checkinteger;
    luaL_checknumber;
    luaL_getsubtable;
    /* blyt32 cart lifecycle (called by libblytcommon.so);
     * cart_lua_modules is provided by the devtool-generated __blyt_lua_glue.c */
    blyt_cart_init;
    blyt_cart_update;
    blyt_cart_draw;
  local: *;
};
