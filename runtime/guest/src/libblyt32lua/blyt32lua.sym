{
  global:
    /* Lua API subset used by BLYT_LUA_EXPORT_* macro-generated wrappers */
    lua_tointegerx;
    lua_tonumberx;
    lua_toboolean;
    lua_pushinteger;
    lua_pushnumber;
    lua_pushboolean;
    /* Lua API used by SDK-generated cart_lua_modules glue */
    lua_pushcfunction;
    lua_setglobal;
    lua_setfield;
    lua_newtable;
    lua_pushvalue;
    lua_getglobal;
    lua_istable;
    lua_getfield;
    lua_pop;
    /* Error reporting */
    luaL_error;
    luaL_checkinteger;
    luaL_checknumber;
    /* Lua C function registration (used by Rust #[lua_export] wrappers) */
    lua_pushcclosure;
    /* blyt32 cart lifecycle (called by libblytcommon.so) */
    blyt_cart_init;
    blyt_cart_update;
    blyt_cart_draw;
    cart_lua_modules;
  local: *;
};
